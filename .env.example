# ---------------------------------------------------------------
# Shopify — Dev Dashboard app (the only option since January 1, 2026)
# ---------------------------------------------------------------
# Your store's myshopify domain, e.g. central-clean.myshopify.com
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# From the Dev Dashboard: Apps -> SDS Emailer -> App settings -> Credentials
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# How these are used:
#  - SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET: the app requests an Admin API
#    access token for your store via the client credentials grant. Tokens last
#    ~24 hours and the app refreshes them automatically — you never paste a
#    token into this file.
#  - SHOPIFY_CLIENT_SECRET: also verifies incoming webhook signatures (HMAC).

# Admin API access token for your PRODUCTION store — obtain it ONCE via the
# in-app install flow: run locally, open http://localhost:3000/auth/install,
# approve on the store, then paste the printed token here AND in Render.
# An explicit token takes priority over the client credentials grant.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Webhook HMAC secret. For a Dev Dashboard app, set this to the SAME value as
# SHOPIFY_CLIENT_SECRET (Shopify signs webhooks with your client secret).
SHOPIFY_API_SECRET=

# Admin API version (latest stable as of writing: 2026-07)
SHOPIFY_API_VERSION=2026-07

# Public HTTPS URL where Shopify delivers the webhook
WEBHOOK_CALLBACK_URL=https://app.example.com/webhooks/orders/paid

# OAuth install redirect — must EXACTLY match an allowed redirect URL
# configured in the Dev Dashboard version. Used once, locally, to obtain the
# store access token.
APP_REDIRECT_URI=http://localhost:3000/auth/callback

# ---------------------------------------------------------------
# SendGrid
# ---------------------------------------------------------------
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender (domain or single sender) in SendGrid
SENDGRID_FROM=no-reply@centralcleaningsupplies.co.uk

# ---------------------------------------------------------------
# SDS matching
# ---------------------------------------------------------------
# Comma-separated categories. Each is matched case-insensitively
# against the product's Product Type AND its collection titles.
SDS_CATEGORIES=Chemicals,Odour Control,Eco Friendly Chemicals,Hand Sanitiser,Hand Soap,Hand Wipes

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------
# Simple JSON file used to remember processed webhook deliveries.
# Replace with a real database (or Shopify's app storage) for production scale.
PROCESSED_ORDERS_FILE=./data/processed-orders.json

PORT=3000
